{
  "name": "boostx/backend",
  "description": "boostX CMS API (Slim 4 + Doctrine ORM)",
  "type": "project",
  "require": {
    "php": "^8.2",
    "doctrine/dbal": "^4.2",
    "doctrine/migrations": "^3.8",
    "doctrine/orm": "^3.3",
    "guzzlehttp/guzzle": "^8.2",
    "nyholm/psr7": "^1.8",
    "oc/ip-region-detector": "@dev",
    "php-di/php-di": "^7.0",
    "php-di/slim-bridge": "^3.4",
    "slim/psr7": "^1.7",
    "slim/slim": "^4.14",
    "symfony/cache": "^7.2",
    "symfony/console": "^7.2",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "start": "php -S 127.0.0.1:8090 -t public public/router.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
